# ========================
# VAMOS FMS — Environment Variables
# ========================
# Salin file ini menjadi .env.demo atau .env.production
# Jangan commit file .env asli ke git!

# Mode Aplikasi: 'demo' | 'production'
VITE_APP_MODE=demo

# Encryption key untuk CryptoJS (AES-256)
# Ganti dengan key rahasia Anda sendiri
VITE_CRYPTO_KEY=ganti-dengan-secret-key-anda

# Debug logger (tampilkan console.log di production)
VITE_VIEW_LOG=false
